# Template credenziali di firma APK THOF
# Copiare questo file in  frontend/android/keystore.properties  e compilare i valori.
# keystore.properties NON viene committato (vedi frontend/android/.gitignore).
#
# In alternativa alle chiavi qui sotto si possono usare le variabili d'ambiente:
#   THOF_KEYSTORE_FILE, THOF_KEYSTORE_PASSWORD, THOF_KEYSTORE_ALIAS, THOF_KEYSTORE_KEY_PASSWORD
#
# storeFile e' relativo a frontend/android/app/ (il keystore THOF e' thof-release.keystore).

storeFile=thof-release.keystore
storePassword=<password-del-keystore>
keyAlias=<alias>
keyPassword=<password-della-chiave>
