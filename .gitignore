# Backend
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.venv/
backend/.env
backend/uploads/
*.egg-info/
# Gli script in scripts/ sono python lanciati dentro il container backend, ma un controllo di sintassi
# (`python3 -m py_compile scripts/ops/...`) lo si fa dalla postazione e lascia il __pycache__ accanto al
# file: senza questa regola finisce in git al primo `git add -A`.
**/__pycache__/
*.pyc

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
# Rigenerato da `prebuild` (frontend/scripts/copy_pdfjs_fonts.mjs) copiandolo da
# node_modules/pdfjs-dist: tracciarlo significherebbe avere una versione dei font diversa da quella
# che pdf.js si aspetta dal pacchetto installato, e il testo rasterizzato uscirebbe storto
frontend/public/pdfjs/

# Docker
# NOTA: .dockerignore va versionato (serve in PROD dove il codice arriva da git),
# quindi NON va messo tra gli ignore.
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test
test.txt
mock-data.json

# Release archives (do not commit these)
releases/
*.apk
*.aab

# Environment files with secrets
.env
.env.dev
.env.prod
!.env.example
.env.local
.env.production
*.local.env

# Google OAuth credentials (mai committare)
backend/google-credentials.json
client_secret_*.json

# Secret scan list per il pre-commit hook (mai committare)
scripts/git-hooks/secrets.lst

# File di sessione, appunti e segreti locali (mai committare)
.local/
SESSION_SUMMARY.md
session-ses_*.md
SECURITY_TODO.json

# Database backups
backups/
*.sql.gz
